---
import { Picture } from 'astro:assets';
import { localSlots } from '../data/local';
import Mark from './Mark.astro';
---

<section class="local" id="local" aria-labelledby="local-title">
  <div class="wrap">
    <p class="kicker">Alzamora</p>
    <h2 id="local-title" class="with-mark"><Mark name="local" /> El local</h2>
    <p class="local-jump"><a href="#contacto">Dirección, horario y domicilio</a></p>
    <div class="local-grid">
      {localSlots.map((slot) => (
        <figure class="frame local-slot arrive">
          {slot.src ? (
            <Picture
              src={slot.src}
              formats={['avif', 'webp']}
              widths={[480, 800, 1200]}
              sizes="(max-width: 760px) 100vw, 34vw"
              alt={slot.alt}
              loading="lazy"
            />
          ) : (
            <div class="local-placeholder" aria-hidden="true">
              <span class="local-kanji">東</span>
              <span class="local-mark"><Mark name="local" /></span>
            </div>
          )}
          <figcaption>
            <span class="local-name">{slot.slot}</span>
            <span class="local-label">{slot.label}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
