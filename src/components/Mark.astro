        <circle cx="38" cy="44" r="3" stroke="#e4272a"></circle>
        <path d="M18 28h8"></path>
      </>
    )}
    {name === 'local' && (
      <>
        <path d="M12 28 32 14l20 14v22H12z"></path>
        <path d="M28 50V36h8v14" stroke="#e4272a"></path>
      </>
    )}
    {name === 'visita' && (
      <>
        <path d="M32 14c8 0 14 6 14 14 0 10-14 22-14 22S18 38 18 28c0-8 6-14 14-14z"></path>
        <circle cx="32" cy="28" r="4" stroke="#e4272a"></circle>
