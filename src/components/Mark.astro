}
const { name } = Astro.props;
---

<svg class="mark" viewBox="0 0 64 64" aria-hidden="true">
  <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    {name === 'nigiri' && (
      <>
        <path d="M14 38c2 8 34 8 36 0-6-4-30-4-36 0z"></path>
        <path d="M18 36c1-8 8-14 14-14s13 6 14 14"></path>
        <path d="M24 28c2-6 14-6 16 0" stroke="#e4272a"></path>
      </>
    )}
    {name === 'maki' && (
      <>
        <circle cx="32" cy="32" r="16"></circle>
        <circle cx="32" cy="32" r="7"></circle>
        <path d="M32 16v4M32 44v4M16 32h4M44 32h4" stroke="#e4272a"></path>
      </>
    )}
    {name === 'temaki' && (
      <>
        <path d="M14 18c10 2 22 12 28 28-12-2-22-10-28-28z"></path>
        <path d="M22 24c6 4 12 12 14 18" stroke="#e4272a"></path>
        <path d="M30 20c2 2 3 5 2 8"></path>
      </>
    )}
    {name === 'uramaki' && (
      <>
        <rect x="14" y="22" width="36" height="20" rx="10"></rect>
        <path d="M22 32h6M36 32h6" stroke="#e4272a"></path>
        <path d="M32 22v20"></path>
      </>
    )}
