      </>
    )}
    {name === 'pescados' && (
      <>
        <path d="M14 32c8-8 20-10 30-6l8-6v20l-8-6c-10 4-22 2-30-2z"></path>
        <circle cx="24" cy="32" r="1.4" fill="#e4272a" stroke="none"></circle>
      </>
    )}
    {name === 'verdura' && (
      <>
        <path d="M32 46V28"></path>
        <path d="M32 32c-8-2-14-8-14-14 8 0 14 6 14 14z"></path>
        <path d="M32 34c8-2 16-6 16-14-8 2-14 8-16 14z" stroke="#e4272a"></path>
