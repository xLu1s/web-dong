---
import { allergenById, type AllergenId } from '../data/menu';

interface Props {
  id: AllergenId;
}

const { id } = Astro.props;
const item = allergenById(id);
---

<svg class="icon" viewBox="0 0 32 32" aria-hidden="true">
  <circle cx="16" cy="16" r="15" fill={item.color}></circle>
  <g fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    {id === 'altramuces' && (
      <g fill="#fff" stroke="none">
        <ellipse cx="12" cy="17" rx="3.2" ry="4.2" transform="rotate(-20 12 17)"></ellipse>
        <ellipse cx="17" cy="14" rx="3.2" ry="4.2" transform="rotate(10 17 14)"></ellipse>
        <ellipse cx="20.5" cy="19" rx="3" ry="4" transform="rotate(28 20.5 19)"></ellipse>
      </g>
    )}
    {id === 'apio' && (
      <path d="M16 24 V10 M16 16 C12 14 10 10 11 7 M16 14 C20 12 22 9 21 6 M16 18 C13 18 11 21 12 24"></path>
    )}
    {id === 'cacahuetes' && (
      <path d="M12 20c0-3 2-4 2-7s-2-4-1-6 5-1 5 2 0 4 1 6 0 6-2 7-5 1-5-2z"></path>
    )}
    {id === 'gluten' && (
      <path d="M16 25 V7 M16 10 c-3 1-5 1-7 0 M16 10 c3 1 5 1 7 0 M16 14 c-3 1-5 1-7 0 M16 14 c3 1 5 1 7 0 M16 18 c-3 1-5 1-6 0 M16 18 c3 1 5 1 6 0"></path>
    )}
    {id === 'crustaceos' && (
      <path d="M11 18c0-5 10-5 10 0 0 4-2 6-5 6s-5-2-5-6z M9 14 H6 M23 14 h3 M12 12 l-2-3 M20 12 l2-3 M13 20 h6"></path>
    )}
    {id === 'frutos' && (
      <path d="M16 9c-4 2-7 6-7 10a7 7 0 0 0 14 0c0-4-3-8-7-10z M16 9 V6"></path>
    )}
    {id === 'sesamo' && (
      <g fill="#fff" stroke="none">
        <ellipse cx="12" cy="14" rx="2" ry="3" transform="rotate(-25 12 14)"></ellipse>
        <ellipse cx="17" cy="12" rx="2" ry="3" transform="rotate(15 17 12)"></ellipse>
        <ellipse cx="20" cy="17" rx="2" ry="3" transform="rotate(30 20 17)"></ellipse>
        <ellipse cx="14" cy="20" rx="2" ry="3" transform="rotate(-10 14 20)"></ellipse>
      </g>
    )}
    {id === 'huevos' && (
      <g fill="#fff" stroke="none">
        <ellipse cx="13" cy="18" rx="4" ry="5"></ellipse>
        <ellipse cx="19" cy="15" rx="3.6" ry="4.6"></ellipse>
      </g>
    )}
    {id === 'lacteos' && (
      <path d="M12 12 h6 l2 3 v8 a4 4 0 0 1-8 0 v-8z M13 12 V9 h4 v3 M12 16 h8"></path>
    )}
    {id === 'moluscos' && (
      <path d="M8 18c2-7 14-7 16 0-4 3-12 3-16 0z M10 18c2-3 10-3 12 0"></path>
    )}
    {id === 'mostaza' && (
      <path d="M14 8 h4 v3 l2 2 v9 a4 4 0 0 1-8 0 v-9 l2-2z M15 8 V6 h2 v2"></path>
    )}
    {id === 'pescado' && (
      <path d="M7 16c4-4 10-5 14-4 l4-3 v10 l-4-3c-4 1-10 0-14-4z M20 16 h.5"></path>
    )}
    {id === 'soja' && (
      <path d="M16 24 C10 18 10 10 16 8 c0 6 2 8 6 8-2 4-4 6-6 8z M16 24 c4-2 8-2 10 1"></path>
    )}
    {id === 'sulfitos' && (
      <text x="16" y="20" text-anchor="middle" font-size="8" font-family="Outfit, sans-serif" fill="#fff" stroke="none">E-X</text>
    )}
  </g>
</svg>
