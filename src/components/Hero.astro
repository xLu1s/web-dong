---
import { Picture } from 'astro:assets';
import hero from '../assets/photos/hero-sushi.jpg';
import Branch from './Branch.astro';
import { phone, phoneDisplay } from '../data/menu';
---

<header class="hero">
  <div class="hero-media">
    <Picture
      src={hero}
      formats={['avif', 'webp']}
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      alt="Variado de sushi sobre una bandeja oscura"
      loading="eager"
      fetchpriority="high"
      quality={68}
    />
  </div>
  <div class="hero-shade" aria-hidden="true"></div>
  <Branch />
  <div class="hero-inner">
    <div class="kanji-lock">
      <p class="kanji" aria-hidden="true">東</p>
      <svg class="kanji-stroke" viewBox="0 0 120 120" aria-hidden="true">
      <path class="draw" pathLength="1" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="square" d="M14 16 H106 M24 32 H96 M60 16 V108 M36 44 H84 V74 H36 Z M36 59 H84 M60 74 L22 108 M60 74 L98 108"></path>
    </svg>
    </div>
    <p class="eyebrow">Alcoy · Alcoi</p>
    <h1 class="wordmark">
      <span class="wordmark-name">Dōng</span>
      <span class="wordmark-sub">Asian &amp; Sushi Bar</span>
    </h1>
    <p class="hero-lead">Sushi, dim sum y wok. Si no está en la carta, lo hacemos.</p>
    <div class="cta-row">
      <a class="btn btn-cream" href="#carta">Ver carta</a>
      <a class="btn btn-ghost" href={`tel:${phone}`}>Llamar / Pedir a domicilio · {phoneDisplay}</a>
    </div>
  </div>
</header>
