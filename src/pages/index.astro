---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import MenuBoard from '../components/MenuBoard.astro';
import LocalGallery from '../components/LocalGallery.astro';
import Mark from '../components/Mark.astro';
import atun from '../assets/photos/casa-1.jpg';
import dimsum from '../assets/photos/dimsum.jpg';
import sashimi from '../assets/photos/sashimi.jpg';
import noodles from '../assets/photos/noodles.jpg';
import { orderUrl, phone, phoneDisplay, sections, setMenus } from '../data/menu';

const title = 'Dōng Asian & Sushi Bar en Alcoy | Carta y domicilio';
const description =
  'Carta de Dōng Asian & Sushi Bar en el Centro Comercial Alzamora, Alcoy. Sushi, dim sum, wok y arroces. A domicilio: 966 333 230. Pedido mínimo 9 €.';

const menuSchema = {
  '@type': 'Menu',
  name: 'Carta Dōng Asian & Sushi Bar',
  hasMenuSection: [
    ...sections.map((section) => ({
      '@type': 'MenuSection',
      name: section.title,
      hasMenuItem: section.dishes.map((dish) => ({
        '@type': 'MenuItem',
        name: `${dish.code}. ${dish.name}`,
        description: dish.description,
        offers: {
          '@type': 'Offer',
          price: dish.price.replace(',', '.'),
          priceCurrency: 'EUR',
        },
      })),
    })),
    {
      '@type': 'MenuSection',
      name: 'Menús para 2 personas',
      hasMenuItem: setMenus.map((menu) => ({
        '@type': 'MenuItem',
        name: `Menú ${menu.letter} para 2 personas`,
        description: menu.items.join('. '),
        offers: {
          '@type': 'Offer',
          price: menu.price.replace(',', '.'),
          priceCurrency: 'EUR',
        },
      })),
    },
  ],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: 'Dōng Asian & Sushi Bar',
  image: 'https://xlu1s.github.io/web-dong/og.jpg',
  servesCuisine: ['Asiática', 'Sushi', 'Japonesa', 'China', 'Tailandesa', 'Vietnamita'],
  telephone: phone,
  url: 'https://xlu1s.github.io/web-dong/',
  sameAs: [orderUrl],
  menu: 'https://xlu1s.github.io/web-dong/#carta',
  hasMenu: menuSchema,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Centro Comercial Alzamora, C/ Els Alçamora, 44, 2.ª planta',
    addressLocality: 'Alcoy',
    addressRegion: 'Alicante',
    postalCode: '03802',
    addressCountry: 'ES',
  },
  priceRange: '€€',
};

---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <Hero />
  <main id="contenido">

  <section class="picks" aria-labelledby="picks-title">
    <div class="wrap">
      <p class="kicker">De la carta</p>
      <h2 id="picks-title" class="arrive">Nigiri, dim sum y menús</h2>
      <div class="pick-grid">
        <a class="pick arrive" href="#nigiri">
          <figure class="frame">
            <Picture src={atun} formats={['avif', 'webp']} widths={[320, 640]} sizes="(max-width: 760px) 100vw, 24vw" alt="Nigiri de atún" loading="lazy" />
          </figure>
          <span class="pick-body"><Mark name="nigiri" /><span><strong>Nigiri</strong><small>2 unidades</small></span></span>
        </a>
        <a class="pick arrive" href="#dim-sum">
          <figure class="frame">
            <Picture src={dimsum} formats={['avif', 'webp']} widths={[320, 640]} sizes="(max-width: 760px) 100vw, 24vw" alt="Empanadillas al vapor" loading="lazy" />
          </figure>
          <span class="pick-body"><Mark name="dim-sum" /><span><strong>Dim sum</strong><small>Gyouzas, shumai, bao</small></span></span>
        </a>
        <a class="pick arrive" href="#arroz">
          <figure class="frame">
            <Picture src={noodles} formats={['avif', 'webp']} widths={[320, 640]} sizes="(max-width: 760px) 100vw, 24vw" alt="Bol de tallarines" loading="lazy" />
          </figure>
          <span class="pick-body"><Mark name="arroz" /><span><strong>Arroz y pasta</strong><small>Arroces y tallarines</small></span></span>
        </a>
        <a class="pick pick-plain arrive" href="#menus">
          <span class="pick-prices"><span>15,95 €</span><span>29,95 €</span></span>
          <span class="pick-body"><Mark name="menus" /><span><strong>Menús para 2</strong><small>Menú A y menú B</small></span></span>
        </a>
      </div>
    </div>
  </section>

  <div class="wrap editorial">
    <figure class="frame arrive">
      <Picture
        src={sashimi}
        formats={['avif', 'webp']}
        widths={[640, 960, 1400]}
        sizes="(max-width: 760px) 100vw, 70vw"
        alt="Tabla de uramaki y maki de salmón"
        loading="lazy"
      />
    </figure>
  </div>

  <MenuBoard />

  <div class="wrap editorial">
    <figure class="frame">
      <Picture
        src={noodles}
        formats={['avif', 'webp']}
        widths={[640, 1100, 1600]}
        sizes="100vw"
        alt="Bol de tallarines con gambas y huevo"
        loading="lazy"
      />
    </figure>
  </div>

  <LocalGallery />

  <section class="visit" id="contacto" aria-labelledby="visita">
    <div class="wrap">
      <p class="kicker">Visita</p>
      <h2 id="visita" class="with-mark arrive"><Mark name="visita" /> Pase o pida a casa</h2>
      <dl class="contact-grid">
        <div class="arrive">
          <dt>Dirección</dt>
          <dd>Centro Comercial Alzamora<br />C/ Els Alçamora, 44, 2.ª planta<br />03802 Alcoy, Alicante</dd>
        </div>
        <div class="arrive">
          <dt>Teléfono</dt>
          <dd><a href={`tel:${phone}`}>{phoneDisplay}</a></dd>
        </div>
        <div class="arrive">
          <dt>A domicilio</dt>
          <dd>Gratis, con pedido mínimo de 9 €. De 12:00 a 16:30 y de 19:30 a 00:00.</dd>
        </div>
        <div class="arrive">
          <dt>Horario de sala</dt>
          <dd>[por confirmar]. En dongasiansushi.com publican 12:00–16:00 y 19:30–24:00.</dd>
        </div>
        <div class="arrive">
          <dt>Pedido online</dt>
          <dd><a href={orderUrl} rel="noopener noreferrer">www.dongasiansushi.com</a></dd>
        </div>
      </dl>
      <div class="cta-row">
        <a class="btn btn-cream" href="#carta">Ver carta</a>
        <a class="btn btn-ghost" href={`tel:${phone}`}>Llamar / Pedir a domicilio</a>
      </div>
      <p>
        <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent('Centro Comercial Alzamora, Calle Els Alçamora 44, Alcoy')}`}>Cómo llegar</a>
      </p>
    </div>
  </section>
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p>Dōng Asian &amp; Sushi Bar</p>
    </div>
  </footer>
</Layout>
